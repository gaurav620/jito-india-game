# =============================================================================
# JITO INDIA GAMES — Environment Variables Template (Phase 2)
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Phase 2 changes: DATABASE_URL (Prisma DSN), REDIS_URL, JWT audience split,
# ENGINE_LEADER_LOCK_TTL_MS, ENGINE_TICK_INTERVAL_MS added.
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD removed in favour of DATABASE_URL.
# =============================================================================

# --- Runtime ---
NODE_ENV=development

# =============================================================================
# JITO API Service (services/api)
# =============================================================================

# Port the API service listens on (must match docker-compose port mapping)
API_PORT=3001

# --- PostgreSQL (Prisma connection string) ---
# Docker local dev default (matches docker-compose.yml credentials):
DATABASE_URL=postgresql://jito:jito_dev_password@localhost:5432/jito_games_dev?schema=public

# --- Redis ---
# Docker local dev default:
REDIS_URL=redis://localhost:6379

# --- Authentication (JWT) ---
# Generate with: openssl rand -base64 64
JWT_SECRET=

# Audience claims — MUST differ between player and admin tokens (ADR-021)
JWT_AUDIENCE_PLAYER=jito-player
JWT_AUDIENCE_ADMIN=jito-admin
JWT_ISSUER=jito-api

# Token TTLs in seconds
JWT_ACCESS_TTL_SECONDS=900      # 15 minutes (AUTH_V2.md §4)
JWT_REFRESH_TTL_SECONDS=604800  # 7 days (AUTH_V2.md §4)

# --- Idempotency key Redis cache ---
IDEMPOTENCY_CACHE_TTL_SECONDS=86400  # 24 hours

# --- CORS (comma-separated list of allowed origins, empty = disabled in production) ---
# Example: CORS_ORIGINS=http://localhost:3000,http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Logging ---
LOG_LEVEL=info   # fatal | error | warn | info | debug | trace
LOG_FORMAT=pretty  # json | pretty  (use json in production)

# =============================================================================
# JITO Game Engine Service (services/game-engine)
# =============================================================================

# Port the game engine listens on (health endpoint only — no player traffic)
GAME_ENGINE_PORT=3003

# Database and Redis are shared with the API service — same vars above apply.
# (Copy DATABASE_URL and REDIS_URL into the game-engine .env if running separately)

# --- Leader lock (Redis SET NX PX — GAME_ENGINE_V2.md §1) ---
ENGINE_LEADER_LOCK_TTL_MS=5000  # Lock expires after 5 s if the process dies without releasing

# --- Reconciler tick (NEEDS CLIENT CONFIRMATION: actual game timing) ---
ENGINE_TICK_INTERVAL_MS=250

# =============================================================================
# Admin panel (apps/admin) — legacy Phase 1 vars retained for compatibility
# =============================================================================
ADMIN_PORT=3002

# =============================================================================
# AWS (production only — leave blank for local dev)
# =============================================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
