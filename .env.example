# =============================================================================
# JITO INDIA GAMES — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jito_games_dev
DB_USER=
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentication ---
JWT_SECRET=
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# --- AWS (production) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# --- WebSocket ---
WS_PORT=3001

# --- Admin ---
ADMIN_PORT=3002

# --- Game Engine ---
GAME_ENGINE_PORT=3003
